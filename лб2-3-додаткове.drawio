        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    Start([Початок]) --&gt; MainLoopStart[Головний цикл do-while]\n    MainLoopStart --&gt; Cls1[system &#39;cls&#39;]\n    Cls1 --&gt; InputPeople[/Введення: peopleCount/]\n    InputPeople --&gt; InitGrand[\&quot;grandTotal = 0.0&lt;br/&gt;totalItemsCount = 0&lt;br/&gt;i = 1\&quot;]\n\n    InitGrand --&gt; ForCond{i &lt;= peopleCount ?}\n\n    ForCond -- Так --&gt; ForBody[Обслуговування Клієнта i]\n    ForBody --&gt; InitClient[\&quot;clientTotal = 0.0&lt;br/&gt;clientItemsCount = 0\&quot;]\n    \n    InitClient --&gt; ClientLoopStart[Цикл замовлення страви]\n    ClientLoopStart --&gt; ShowMenu[/Показ меню кафетерию/]\n    ShowMenu --&gt; InputChoice[/Введення: choice/]\n    InputChoice --&gt; SwitchChoice{Вибір choice}\n\n    SwitchChoice -- 1..7 --&gt; AddItem[\&quot;Додавання ціни до clientTotal&lt;br/&gt;clientItemsCount++\&quot;]\n    SwitchChoice -- Некоректно --&gt; ErrorMsg[/Повідомлення про помилку/]\n\n    AddItem --&gt; AskMore[/Введення: addMore/]\n    ErrorMsg --&gt; AskMore\n    AskMore --&gt; CheckMore{addMore != 0 ?}\n\n    CheckMore -- Так --&gt; ClientLoopStart\n    CheckMore -- Ні --&gt; AddToGrand[\&quot;grandTotal += clientTotal&lt;br/&gt;totalItemsCount += clientItemsCount\&quot;]\n    AddToGrand --&gt; IncI[\&quot;i = i + 1\&quot;]\n    IncI --&gt; ForCond\n\n    ForCond -- Ні --&gt; FinalReceipt[/Виведення підсумкового чека:&lt;br/&gt;людей, страв, grandTotal/]\n    FinalReceipt --&gt; Pause[system &#39;pause&#39;]\n    Pause --&gt; AskMain[/Введення: mainLoop/]\n    AskMain --&gt; CheckMain{mainLoop != 0 ?}\n\n    CheckMain -- Так --&gt; MainLoopStart\n    CheckMain -- Ні --&gt; End([Кінець])&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ghcyw8vC86o7IGOCDwSu-1">
